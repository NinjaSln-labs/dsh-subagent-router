{
  "name": "dsh-subagent-router",
  "description": "Model-routed subagent delegation for DeepSeek Harness: a `subagent_model` tool with per-call provider/model/max_tokens overrides and a built-in `model: \"auto\"` routing policy (anchored to the parent's own model by default; task-tier upgrades, failure escalation, auditable reason), plus a `subagent_models` catalog tool. Children no longer need to inherit the parent's model.",
  "version": "0.3.0",
  "author": {
    "name": "ninjasln",
    "url": "https://github.com/NinjaSln-labs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NinjaSln-labs/dsh-subagent-router.git"
  },
  "homepage": "https://github.com/NinjaSln-labs/dsh-subagent-router#readme",
  "bugs": {
    "url": "https://github.com/NinjaSln-labs/dsh-subagent-router/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "subagent",
    "model-routing",
    "llm",
    "auto",
    "delegation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit || true",
    "test": "vitest run",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-jobs": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-subagent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-attachment": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-brand": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-code-runtime": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-jobs": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-scope": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-subagent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-timeout": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-user-approval": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-util-time": "^0.1.2-alpha.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
